// Pump Rewards — PostgreSQL schema (Prisma 7).
// The connection URL lives in prisma.config.ts, not here.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum StaffRole {
  ADMIN
  CASHIER
}

enum TransactionType {
  EARN
  REDEEM
}

enum TransactionSource {
  FUEL_ENTRY
  FUEL_CLAIM
  REFERRAL
  REDEMPTION
  /// Points handed back because a redemption request was cancelled or rejected.
  REDEMPTION_REFUND
}

enum OtpPurpose {
  REGISTER
  RESET_PIN
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Cashiers and admins. Created only by an admin, never by self sign-up.
model Staff {
  id           String    @id @default(uuid()) @db.Uuid
  name         String
  /// Stored lowercase so logins are case-insensitive.
  username     String    @unique
  passwordHash String
  role         StaffRole
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  transactions       PointTransaction[]
  redemptionRequests RedemptionRequest[]
  fuelClaims         FuelClaim[]
}

model Customer {
  id             String   @id @default(uuid()) @db.Uuid
  /// 10-digit mobile number; doubles as the customer's login and referral code.
  phone          String   @unique
  pinHash        String
  name           String
  /// Spendable balance.
  points         Int      @default(0)
  /// Total ever earned; drives the loyalty tier and never goes down.
  lifetimePoints Int      @default(0)
  referredById   String?  @db.Uuid
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  referredBy Customer?  @relation("Referrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals  Customer[] @relation("Referrals")

  vehicles           Vehicle[]
  transactions       PointTransaction[]
  redemptionRequests RedemptionRequest[]
  fuelClaims         FuelClaim[]

  @@index([name])
}

model Vehicle {
  id         String   @id @default(uuid()) @db.Uuid
  customerId String   @db.Uuid
  model      String   @default("")
  /// Standard spaced form, e.g. "MH 36 AD 2861".
  number     String
  /// Number without spaces, used for uniqueness and search.
  numberKey  String
  createdAt  DateTime @default(now())

  customer   Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  fuelClaims FuelClaim[]

  /// A plate belongs to one customer: the same vehicle cannot be on two profiles (it would earn points twice).
  @@unique([numberKey])
  @@index([customerId])
}

/// Reward catalog (the "schemes"). `id` is a stable slug such as "thermos-cup-set".
model Reward {
  id        String  @id
  name      String
  points    Int
  icon      String
  active    Boolean @default(true)
  sortOrder Int     @default(0)

  redemptionRequests RedemptionRequest[]

  @@index([sortOrder])
}

/// Append-only points ledger. Rows are never updated or deleted, so any history window
/// (including the 45-day issue log) can always be reconstructed.
model PointTransaction {
  id               String            @id @default(uuid()) @db.Uuid
  customerId       String            @db.Uuid
  type             TransactionType
  source           TransactionSource
  label            String
  amount           Int
  fuelAmountRupees Int?
  /// The staff member who recorded or approved it, when there was one.
  performedById    String?           @db.Uuid
  createdAt        DateTime          @default(now())

  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  performedBy Staff?   @relation(fields: [performedById], references: [id], onDelete: SetNull)

  @@index([customerId, createdAt])
}

model RedemptionRequest {
  id           String       @id @default(uuid()) @db.Uuid
  customerId   String       @db.Uuid
  rewardId     String
  /// Snapshots, so the log stays accurate if the catalog changes later.
  rewardName   String
  rewardIcon   String
  points       Int
  status       ReviewStatus @default(PENDING)
  requestedAt  DateTime     @default(now())
  resolvedAt   DateTime?
  resolvedById String?      @db.Uuid

  /// When the points were taken from the customer: the moment they asked for the gift. Null on requests made before points
  /// were taken up front; those still hold the points until a staff member hands the gift over.
  pointsDeductedAt    DateTime?
  /// When the points were given back because the request was cancelled or rejected.
  refundedAt          DateTime?
  rejectionReason     String?
  /// True when the customer cancelled their own request (as opposed to staff rejecting it).
  cancelledByCustomer Boolean   @default(false)
  /// The handover: a photo of the customer receiving the gift, and where it was taken. The bytes are left out of normal
  /// queries (see lib/prisma.ts); the mime type says whether a photo exists.
  handoverPhoto       Bytes?
  handoverPhotoMime   String?
  handoverLatitude    Float?
  handoverLongitude   Float?
  handoverAccuracy    Float?

  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  reward     Reward   @relation(fields: [rewardId], references: [id])
  resolvedBy Staff?   @relation(fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([status, requestedAt])
  @@index([customerId])
  @@index([status, resolvedAt])
}

/// A customer's "I just filled fuel" proof: dashboard photo + GPS, reviewed by staff.
model FuelClaim {
  id                  String       @id @default(uuid()) @db.Uuid
  customerId          String       @db.Uuid
  vehicleId           String?      @db.Uuid
  vehicleModel        String       @default("")
  vehicleNumber       String
  claimedAmountRupees Int
  latitude            Float
  longitude           Float
  accuracy            Float?
  /// The photo itself, kept in the database so it survives on hosts with no persistent disk (Vercel). Left out of normal
  /// queries (see lib/prisma.ts) so listing claims never loads image bytes.
  photoData           Bytes?
  /// Legacy: photos saved before they moved into the database are files under UPLOAD_DIR; this is their relative path.
  photoPath           String?
  photoMime           String
  status              ReviewStatus @default(PENDING)
  rejectionReason     String?
  submittedAt         DateTime     @default(now())
  resolvedAt          DateTime?
  resolvedById        String?      @db.Uuid
  approvedAmountRupees Int?
  pointsAwarded       Int?

  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  vehicle    Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  resolvedBy Staff?   @relation(fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([status, submittedAt])
  @@index([customerId, submittedAt])
}

/// One-time codes sent by SMS. Only a keyed hash of the code is stored, never the code itself.
/// Short-lived working data (not audit data): rows older than a day are purged opportunistically.
model OtpCode {
  id         String     @id @default(uuid()) @db.Uuid
  phone      String
  purpose    OtpPurpose
  codeHash   String
  /// Wrong guesses so far; the code is dead after too many.
  attempts   Int        @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime   @default(now())

  @@index([phone, purpose, createdAt])
}

/// A signed-in device session. The app keeps a short-lived access token and swaps this long-lived refresh token for a new
/// pair when it expires; each use rotates it. Only a hash of the token is stored, never the token itself.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @unique
  /// The customer or staff member this session belongs to.
  subjectId String    @db.Uuid
  isStaff   Boolean
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([subjectId])
}

/// Single-row table (id = 1) holding the program rules that admins can tune.
model Setting {
  id                  Int      @id @default(1)
  /// Rupees per litre, with up to 2 decimals (e.g. 99.38). Points are earned per litre, so rupees / rate, rounded.
  fuelRatePerLitre    Float    @default(100)
  minFuelAmountRupees Int      @default(500)
  referralBonusPoints Int      @default(100)
  /// Where the pump is. Once set, fuel and gift-handover photos are only accepted when taken within `geofenceMeters` of it.
  /// Null until an admin sets it (nothing is checked before that).
  pumpLatitude        Float?
  pumpLongitude       Float?
  geofenceMeters      Int      @default(200)
  updatedAt           DateTime @updatedAt
}
