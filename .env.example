# Copy to .env and adjust.
NODE_ENV=development
PORT=4100

# PostgreSQL connection string (see docker-compose.yml for a ready-made local database).
# Render PostgreSQL from your own PC: use the *External* URL (host ends .render.com) and add ?sslmode=require
# (Render rejects non-SSL connections). Inside Render itself use the *Internal* URL, no sslmode needed.
DATABASE_URL="postgresql://pump:pump_dev_password@localhost:5432/pump_rewards?schema=public"

# Use a long random value in production (min 32 chars), e.g. `openssl rand -base64 48`.
JWT_SECRET="change-me-to-a-long-random-string-of-at-least-32-chars"
JWT_EXPIRES_IN=1h

# Comma-separated list of allowed browser origins ("*" allows any; fine for local dev only).
CORS_ORIGINS=*

# Fuel-proof photos are stored in the database. UPLOAD_DIR is only read to serve older photos that were saved as files.
UPLOAD_DIR=uploads

# PIN given to customers that a cashier/admin registers on their behalf.
DEFAULT_CUSTOMER_PIN=1234

# SMS verification (a 6-digit code texted at sign-up and on "forgot PIN"). OFF by default: the app works without any SMS,
# and staff reset a forgotten PIN from the customer's page. Set to true to turn the SMS flows on.
OTP_ENABLED=false

# Fast2SMS API key (Dev API > API Key) used to text OTP codes. Only used when OTP_ENABLED=true. Keep it secret.
# Leave empty in development: codes are then printed to the server console (and returned as `devOtp`) instead of sent.
# Required when NODE_ENV=production and OTP_ENABLED=true.
FAST2SMS_API_KEY=

# Used by `npm run db:seed` for the demo staff accounts.
SEED_ADMIN_PASSWORD=admin123
SEED_CASHIER_PASSWORD=cashier123
